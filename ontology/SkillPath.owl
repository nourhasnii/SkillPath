     -->

    


    <!-- http://www.skillpath.tn/onto#Competence -->

    <owl:Class rdf:about="http://www.skillpath.tn/onto#Competence"/>
    


    <!-- http://www.skillpath.tn/onto#CompetenceManquante -->

    <owl:Class rdf:about="http://www.skillpath.tn/onto#CompetenceManquante">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.skillpath.tn/onto#Competence"/>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
                                <owl:onProperty>
                                    <rdf:Description>
                                        <owl:inverseOf rdf:resource="http://www.skillpath.tn/onto#aAcquis"/>
                                    </rdf:Description>
                                </owl:onProperty>
                                <owl:someValuesFrom rdf:resource="http://www.skillpath.tn/onto#ProfilUtilisateur"/>
                            </owl:Restriction>
                        </owl:complementOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.skillpath.tn/onto#CompetenceTechnique -->

    <owl:Class rdf:about="http://www.skillpath.tn/onto#CompetenceTechnique">
        <rdfs:subClassOf rdf:resource="http://www.skillpath.tn/onto#Competence"/>
    </owl:Class>
    


    <!-- http://www.skillpath.tn/onto#CompetenceTransverse -->

    <owl:Class rdf:about="http://www.skillpath.tn/onto#CompetenceTransverse">
