    </owl:Class>
    


    <!-- http://www.skillpath.tn/onto#ProfilEligible -->

    <owl:Class rdf:about="http://www.skillpath.tn/onto#ProfilEligible">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.skillpath.tn/onto#ProfilUtilisateur"/>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.skillpath.tn/onto#vise"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://www.skillpath.tn/onto#Metier"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://www.skillpath.tn/onto#requiert"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="http://www.skillpath.tn/onto#Competence"/>
                                                            <owl:Class>
                                                                <owl:complementOf>
                                                                    <owl:Restriction>
                                                                        <owl:onProperty>
                                                                            <rdf:Description>
                                                                                <owl:inverseOf rdf:resource="http://www.skillpath.tn/onto#aAcquis"/>
                                                                            </rdf:Description>
                                                                        </owl:onProperty>
                                                                        <owl:someValuesFrom rdf:resource="http://www.skillpath.tn/onto#ProfilUtilisateur"/>
                                                                    </owl:Restriction>
                                                                </owl:complementOf>
                                                            </owl:Class>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:complementOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.skillpath.tn/onto#vise"/>
                        <owl:someValuesFrom rdf:resource="http://www.skillpath.tn/onto#Metier"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.skillpath.tn/onto#ProfilEtudiant -->

    <owl:Class rdf:about="http://www.skillpath.tn/onto#ProfilEtudiant">
        <rdfs:subClassOf rdf:resource="http://www.skillpath.tn/onto#ProfilUtilisateur"/>
