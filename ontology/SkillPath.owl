    <!-- http://www.skillpath.tn/onto#comp_Python -->

    <owl:NamedIndividual rdf:about="http://www.skillpath.tn/onto#comp_Python">
        <rdf:type rdf:resource="http://www.skillpath.tn/onto#CompetenceTechnique"/>
